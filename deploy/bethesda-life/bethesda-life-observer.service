# The read-only observer of the Bethesda life (src/bethesda/life/observer.ts):
# serves the witness of /run/bethesda-life/observation.json, which the life
# writes about once a second, on 127.0.0.1:8790. Caddy (public.sh) puts it on
# the internet over HTTPS. Installed by install.sh next to this file; read
# "Witnessing it" in docs/BETHESDA_CONTINUOUS_LIFE.md.
#
# It is independent of the life on purpose: while the life is stopped it keeps
# serving, and says the life is unavailable.

[Unit]
Description=Bethesda life observer (read-only witness of the one life)
Documentation=https://github.com/topherchris420/lop-nur-twin/blob/main/docs/BETHESDA_CONTINUOUS_LIFE.md
After=network.target
StartLimitIntervalSec=0

[Service]
Type=exec
# Its own throwaway user: it can read the observation and nothing of the store.
DynamicUser=yes
WorkingDirectory=/opt/bethesda-life/current
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/opt/bethesda-life/node/bin/node scripts/run-ts.mjs scripts/bethesda-life-observer.ts --file /run/bethesda-life/observation.json --port 8790
Restart=always
RestartSec=5
MemoryMax=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bethesda-life-observer

# It listens on loopback only and writes nowhere.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/bethesda-life
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
