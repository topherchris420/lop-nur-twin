    "ir": {
      "schema": "rain-scientific-experiment/v1",
      "domain": "fly-behavior-simulation",
      "backend": "digital-fly",
      "backend_version": "digital-fly-behavior/v1 (digital-fly/2 reduced-order-fsm/v1)",
      "question": "In the digital fly simulator, how does repeating a looming stimulus every 4 s change fraction of the second half of repeated presentations answered by an escape, against the same stimulus every 120 s on matched seeds?",
      "hypothesis": "Repeating a looming stimulus every 4 s will decrease late_escape_probability by at least 0.2 fraction on average over matched seeds, compared with the same stimulus every 120 s, in the expected direction in at least 8 of 12 seeds.",
      "observables": [
        {
          "id": "repeat_escape_probability",
          "unit": "fraction",
          "description": "fraction of repeated presentations answered by an escape"
        },
        {
          "id": "late_escape_probability",
          "unit": "fraction",
          "description": "fraction of the second half of repeated presentations answered by an escape"
        },
        {
          "id": "presentations",
          "unit": "count",
          "description": "repeated presentations delivered (each waits for the fly to have stood for a set time)"
        },
        {
          "id": "mean_isi_s",
          "unit": "s",
          "description": "mean interval between successive presentations as delivered"
        },
        {
          "id": "repeat_size_at_escape_deg",
          "unit": "deg",
          "description": "mean angular size of the repeated stimulus at the escape decision"
        },
        {
          "id": "mean_paired_delta",
          "unit": "fraction",
          "description": "treatment minus control late_escape_probability, averaged over seeds"
        }
      ],
      "independent_variables": [
        "repeating a looming stimulus every 4 s"
      ],
      "dependent_variables": [
        "late_escape_probability"
      ],
      "controls": [
        "baseline arm: the same stimulus every 120 s",
        "matched seeds: each seed places the fly, draws its stimuli and seeds its random streams identically in both arms",
        "fixed apparatus settings, both arms — repeat block: groomHz = 0, takeoffHz = 0, walkStartHz = 0",
        "the fly's version, controller and full parameter table are bound into the plan digest"
      ],
      "parameter_constraints": [
        "six closed protocols with host-built arenas and stimuli",
        "controller configurations override model parameters only; FlyBody and published values are fixed",
        "the integration settings (physics, sensing and decision periods) are never varied",
        "at most 16000 simulated fly-seconds per experiment",
        "8-16 distinct seeds; the effect must appear in at least half of them"
      ],
      "resource_budget": {
        "execution_steps": 2664800,
        "replay_steps": 2664800,
        "max_samples": 24
      },
      "statistical_analysis": {
        "method": "Matched-seed paired difference of the primary metric; per-seed sign counts; frozen rain-criteria/v1",
        "independent_replicates": 12,
        "uncertainty": "Seeds are independent replicates of one reduced-order model; descriptive only, with no p-value or population inference, and nothing about real flies."
      },
      "falsification": {
        "metric": "mean_paired_delta",
        "op": ">=",
        "value": 0,
        "unit": "fraction"
      },
      "provenance": {
        "generation": "scripted",
        "decision_sha256": null,
        "source_ids": [],
        "parent_record_sha256": null
      },
      "limitations": [
        "The digital fly's controller is a reduced-order state machine. It simulates no neurons; its links to Virtual Fly Brain terms are labels, not mechanisms.",
        "Model parameters were chosen for this simulator, not measured or fitted; a result describes the simulator with these values.",
        "Flight is kinematic: no aerodynamics and no MuJoCo physics run in these experiments.",
        "The arena is a box with primitive obstacles and a relative light proxy (not lux); odour, temperature, humidity, airflow and food are not simulated.",
        "Looming stimuli are visual objects only: the fly sees them but cannot touch them, and escape is a giant-fiber proxy, not a modelled neuron.",
        "A result characterizes the simulator and is never empirical evidence about Drosophila."
      ]
