{
  "schema": "rain-fly-record/v2",
  "run_id": "FR-c2560d9d73458ed553b728cf",
  "plan": {
    "schema": "rain-fly-plan/v2",
    "design": {
      "schema": "rain-fly-design/v2",
      "question": "[scripted] Does the simulated fly's escape response habituate when the looming stimulus repeats quickly?",
      "hypothesis": "[scripted] Repeating the stimulus every 4 s lowers the escape probability over the later presentations, compared with every 120 s.",
      "competing_hypothesis": "[scripted] The stimulus stays above the escape threshold however often it repeats.",
      "parameters": {
        "seed_count": 12,
        "treatment": {
          "kind": "adaptation",
          "isi_s": 4
        }
      },
      "analysis": {
        "method": "matched_seed_sign_test",
        "metric": "late_escape_probability",
        "expected_direction": "decrease",
        "minimum_effect": 0.2
      },
      "budget": {
        "max_simulated_seconds": 16000
      },
      "provenance": {
        "generation": "scripted",
        "decision_sha256": null,
        "source_ids": [],
        "parent_record_sha256": null
      }
    },
    "ir": {
      "schema": "rain-scientific-experiment/v1",
      "domain": "fly-behavior-simulation",
      "backend": "digital-fly",
      "backend_version": "digital-fly-behavior/v2 (digital-fly/3 reduced-order-fsm/v1)",
      "question": "In the digital fly simulator, how does repeating a looming stimulus nominally every 4 s change fraction of the second half of repeated presentations answered by an escape, against the same stimulus nominally every 120 s on matched seeds?",
      "hypothesis": "Repeating a looming stimulus nominally every 4 s will decrease late_escape_probability by at least 0.2 fraction on average over 12 matched seeds drawn after preregistration, compared with the same stimulus nominally every 120 s, and an exact one-sided sign test on the seeds that differ will find the decrease at alpha 0.05.",
      "observables": [
        {
          "id": "repeat_escape_probability",
          "unit": "fraction",
          "description": "fraction of repeated presentations answered by an escape"
        },
        {
          "id": "late_escape_probability",
          "unit": "fraction",
          "description": "fraction of the second half of repeated presentations answered by an escape"
        },
        {
          "id": "presentations",
          "unit": "count",
          "description": "repeated presentations delivered (each waits for the fly to have stood for a set time)"
        },
        {
          "id": "mean_isi_s",
          "unit": "s",
          "description": "mean interval between successive presentations as delivered"
        },
        {
          "id": "repeat_size_at_escape_deg",
          "unit": "deg",
          "description": "mean angular size of the repeated stimulus at the escape decision"
        },
        {
          "id": "mean_paired_delta",
          "unit": "fraction",
          "description": "treatment minus control late_escape_probability, averaged over the seeds where both are defined"
        },
        {
          "id": "sign_test_p_expected",
          "unit": "probability",
          "description": "exact one-sided sign test p-value for a decrease, over untied seeds"
        },
        {
          "id": "sign_test_p_opposite",
          "unit": "probability",
          "description": "the same test in the opposite direction"
        }
      ],
      "independent_variables": [
        "repeating a looming stimulus nominally every 4 s"
      ],
      "dependent_variables": [
        "late_escape_probability"
      ],
      "controls": [
        "baseline arm: the same stimulus nominally every 120 s",
        "matched seeds: each seed places the fly, draws its stimuli and seeds its random streams identically in both arms",
        "the seeds are drawn by the host after preregistration from SHA-256 of the registry receipt and a random nonce in the authorization, so neither the design nor the operator chooses them",
        "fixed apparatus settings, both arms — repeat block: groomHz = 0, takeoffHz = 0, walkStartHz = 0",
        "the fly's version, controller, full parameter table and source digest are bound into the plan digest"
      ],
      "parameter_constraints": [
        "six closed protocols with host-built arenas and stimuli",
        "controller configurations override model parameters only, within their ranges; FlyBody and published values are fixed",
        "the integration settings (physics, sensing and decision periods) are never varied",
        "at most 16000 simulated fly-seconds per experiment",
        "8-16 seeds, drawn by the host after preregistration",
        "a minimum effect at or above the host's 0.1 fraction for late_escape_probability"
      ],
      "resource_budget": {
        "execution_steps": 2664800,
        "replay_steps": 2664800,
        "max_samples": 24
      },
      "statistical_analysis": {
        "method": "Exact one-sided sign test on the untied matched seeds at alpha 0.05, with at least 6 untied seeds, and a mean paired difference beyond the minimum effect; frozen rain-criteria/v1",
        "independent_replicates": 12,
        "uncertainty": "The p-values are exact binomial tail probabilities over seeds of one deterministic model: they say how consistently the two arms differ across this simulator's seeds, not how uncertain anything is about a population, and nothing about real flies."
      },
      "falsification": {
        "metric": "sign_test_p_opposite",
        "op": "<=",
        "value": 0.05,
        "unit": "probability"
      },
      "provenance": {
        "generation": "scripted",
        "decision_sha256": null,
        "source_ids": [],
        "parent_record_sha256": null
      },
      "limitations": [
        "The digital fly's controller is a reduced-order state machine. It simulates no neurons; its links to Virtual Fly Brain terms are labels, not mechanisms.",
        "Model parameters were chosen for this simulator, not measured or fitted; a result describes the simulator with these values.",
        "Flight is kinematic: no aerodynamics and no MuJoCo physics run in these experiments.",
        "The arena is a box with primitive obstacles and a relative light proxy (not lux); odour, temperature, humidity, airflow and food are not simulated.",
        "The interval is not fixed: each presentation waits for the fly to have stood still, so the delivered interval depends on the fly's response (mean_isi_s reports it) and is longer than the nominal one.",
        "Looming stimuli are visual objects only: the fly sees them but cannot touch them, and escape is a giant-fiber proxy, not a modelled neuron.",
        "Re-simulation is exact on the JavaScript engine that made a record; Math functions differ in their last bits between engines, so on another engine a record is reported as not re-simulable rather than checked.",
        "A result characterizes the simulator and is never empirical evidence about Drosophila."
      ]
    },
