  "plan": {
    "schema": "rain-fly-plan/v2",
    "design": {
      "schema": "rain-fly-design/v3",
      "question": "[scripted] Does sensory noise change when the simulated fly escapes from a looming stimulus?",
      "hypothesis": "[scripted] Sensory noise of 0.4 makes the fly escape earlier in the approach, with more time to collision: noisy size and expansion estimates cross the escape threshold early.",
      "competing_hypothesis": "[scripted] Noise averages out over the approach and leaves the time to collision at the escape unchanged.",
      "parameters": {
        "seed_count": 9,
        "treatment": {
          "kind": "noisy_sensing",
          "noise": 0.4
        }
      },
      "analysis": {
        "method": "matched_seed_sign_test",
        "metric": "escape_ttc_s",
        "expected_direction": "increase",
        "minimum_effect": 0.23
      },
      "budget": {
        "max_simulated_seconds": 16000
      },
      "provenance": {
        "generation": "scripted",
        "decision_sha256": null,
        "source_ids": [],
        "parent_record_sha256": null
      }
    },
    "ir": {
      "schema": "rain-scientific-experiment/v1",
      "domain": "fly-behavior-simulation",
      "backend": "digital-fly",
      "backend_version": "digital-fly-behavior/v3 (digital-fly/4 reduced-order-fsm/v1)",
      "question": "In the digital fly simulator, how does sensory noise of 0.4 (standard deviation 0.23: relative on sizes, distances and light levels, in radians on directions) change mean time to collision at the escape decision, over escapes: how long the sphere's centre would still have taken to reach the fly at its approach speed (negative once it would have passed), against noiseless sensing on matched seeds?",
      "hypothesis": "Sensory noise of 0.4 (standard deviation 0.23: relative on sizes, distances and light levels, in radians on directions) will increase escape_ttc_s by at least 0.23 s on average over 9 matched seeds drawn after preregistration, compared with noiseless sensing, and an exact one-sided sign test on the seeds that differ will find the increase at alpha 0.05.",
      "observables": [
        {
          "id": "collision_episodes_per_m",
          "unit": "1/m",
          "description": "collision episodes per metre flown in pillar clutter"
        },
        {
          "id": "cruise_collision_episodes_per_m",
          "unit": "1/m",
          "description": "collision episodes that began in cruising flight (not during a landing approach) per metre flown in pillar clutter"
        },
        {
          "id": "collision_episodes",
          "unit": "count",
          "description": "collision episodes in pillar clutter (contacts less than 0.1 s apart are one episode)"
        },
        {
          "id": "near_miss_fraction",
          "unit": "fraction",
          "description": "fraction of cruising flight spent within 5 cm of a pillar or wall, measured by the host from the arena's geometry"
        },
        {
          "id": "flown_m",
          "unit": "m",
          "description": "distance flown in pillar clutter"
        },
        {
          "id": "saccades_per_flight_s",
          "unit": "1/s",
          "description": "body saccades per second of flight in pillar clutter"
        },
        {
          "id": "contact_s",
          "unit": "s",
          "description": "time spent pressed against a surface while flying or landing in pillar clutter"
        },
        {
          "id": "escape_probability",
          "unit": "fraction",
          "description": "fraction of single-stimulus trials answered by an escape takeoff"
        },
        {
          "id": "escape_ttc_s",
          "unit": "s",
          "description": "mean time to collision at the escape decision, over escapes: how long the sphere's centre would still have taken to reach the fly at its approach speed (negative once it would have passed)"
        },
        {
          "id": "escape_latency_s",
          "unit": "s",
          "description": "mean time from stimulus onset to the escape decision, over escapes"
        },
        {
