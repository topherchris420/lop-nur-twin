node_modules
dist
.omx/
dist-ssr
dist-garden
*.local
.DS_Store
*.log
.vite
.vercel
.env*
# The one env file that is committed: placeholders only, never a value.
!.env.example
.gstack/

# Generated per build by scripts/generate-manifest.ts. It is a release artifact
# describing the build that produced it, not source — `bun run dev`, `bun run
# build` and CI all regenerate it, and committing it would only churn its
# generatedAt timestamp.
public/model-manifest.json

# SBOMs and scanner reports produced by CI or a local security run.
sbom*.json
trivy-results.*

# `bun run test:coverage` output.
coverage/

# The live garden's harness (tools/garden.mjs): its check's report and
# photographs, and recordings of live states. Evidence for a review.
garden-check/
garden-recording-*.jsonl

# tools/probe.mjs output
render_output.png
render_output-*.png

# tools/frames.mjs and tools/closeup.mjs output. Captures are evidence for a
# review, not project assets — and the no-binary-assets rule means they must
# never be committed. The manifest next to them is regenerated per run.
shots/

# Scratch worktrees for parallel agents; each is its own checkout.
.claude/worktrees/

# Python bytecode from the data importers under scripts/ and from fly-physics/.
__pycache__/
*.pyc

# The FlyBody physics backend's working files (fly-physics/README.md): its
# virtual environment, the FlyBody checkout it fetches by git, and the traces
# scripts/fly-physics-trace.ts writes. All derived; none is source.
.fly-physics/
.pytest_cache/

# R.A.I.N.'s autonomous research state (`npm run rain:autonomous`): sealed
# records, session traces, charters and their authorizations, and the
# registry. Research output of one machine, not source.
.rain-research/

# Noeterra's Rust build output, including the WebAssembly engine the R.A.I.N. Lab
# loads (`npm run noeterra:wasm`). Binaries are built, never committed.
noeterra/target/

# The Noeterra engine copied in for /noeterra by scripts/copy-noeterra-wasm.mjs.
public/noeterra/
