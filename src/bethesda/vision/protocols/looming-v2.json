{
  "schema": "vision-looming-protocol/v1",
  "id": "looming-v2",
  "frozen": "2026-11-07, committed before either split of looming-v2 ran, after looming-v1's held-out split had run and was spent.",
  "question": "Does an image-forming compound eye with LPLC2-like radial-motion-opponent looming units let a research fly in the deployed configuration escape from objects on a collision course while ignoring harmless motion, better than the deployed controller's geometric giant-fiber proxy?",
  "status": "A seeded study on research subjects, not a registered R.A.I.N. experiment. No subject is Eva or ECHO, a copy of either, or a continuation of either.",
  "vision_version": "research-compound-eye/2",
  "change_from_v1": "The only change to the eye: its photoreceptors adapt in log luminance (a linear high-pass of log luminance) instead of signalling Weber contrast against a running mean. Found by a post-hoc look at looming-v1's spent held-out split: the eye escaped from dark stationary objects 1.2-1.5 s after they appeared while the body did not move, because Weber adaptation recovers at a pace that depends on how dark each ommatidium went. Everything else (lattice, detectors, looming units, readouts, arms, selection rule, criteria, cells) is v1's. The development split is v1's (same stimuli and fly seeds); the held-out split is new: new generator seed, new fly seeds, the same cells, never run before this protocol was committed.",
  "fly": {
    "position": [
      0,
      0.01,
      0
    ],
    "yaw": 0,
    "note": "A new research fly per run, perched at the arena's centre in the deployed configuration (OrganismAdapter: ECHO v3 over the reduced-order controller, with the mushroom body, olfactory navigation and physiology), spontaneous takeoff, walking and grooming off."
  },
  "timeline": {
    "lead_in_s": 1.0,
    "tail_s": 0.3,
    "sample_s": 0.01
  },
  "ground_truth": {
    "collision_margin_m": 0.01,
    "harmless_min_surface_m": 0.05,
    "rule": "From the kinematics alone: a threat's surface comes within 1 cm of the fly; a harmless stimulus keeps it at least 5 cm away; nothing in between is generated."
  },
  "arms": {
    "deployed": "The deployed controller's own giant-fiber proxy at its deployed threshold (gfThreshold 1.0): its first escape command in the held run. Untuned.",
    "geometric-tuned": "The same geometric proxy (from the world's geometry: the object's angular size and expansion), its threshold chosen on development trials by the selection rule.",
    "eye-lplc2": "The research compound eye: Hassenstein–Reichardt detectors and LPLC2-like units (radial motion opponency, all four quadrants), summed into a giant-fiber drive; its gain chosen on development trials by the selection rule. Primary arm.",
    "eye-expansion": "Ablation: the same eye and units read as outward-motion energy only (no inhibition by inward motion, no all-quadrant combination); threshold by the selection rule.",
    "eye-shuffled": "Control: the same eye and LPLC2 readout with each eye's ommatidia fed to the detectors through a fixed random permutation (retinotopy destroyed, every signal kept); threshold by the selection rule.",
    "size-heuristic": "Simple non-neural baseline: escape when the geometric angular size of the strongest looming object reaches a threshold chosen by the selection rule. Reads the world's geometry.",
    "tau-heuristic": "Simple non-neural baseline: escape when expansion rate over angular size (the inverse of the visual time to contact) reaches a threshold chosen by the selection rule. Reads the world's geometry."
  },
  "selection": {
    "min_recall": 0.8,
    "grid": 80,
    "rule": "On development trials only, for every arm but deployed: an 80-point log-spaced grid of thresholds from the 1st percentile to the maximum of the trials' peak values; the highest F1 with recall >= 0.8, then the longer median lead, then the higher threshold; if none reaches recall 0.8, the highest recall, then F1. The eye's gain is the deployed threshold over the chosen eye threshold, so the deployed reflex decides on it unchanged."
  },
  "scoring": "A decision is the first call (every 10 ms sample) at which the readout reaches its threshold. A threat is hit by a decision at or after it appears and before it collides; a harmless stimulus is a false alarm if any decision falls in its run; a decision before the stimulus appears is early (a false positive and, for a threat, a miss). F1 = 2TP / (2TP + FP + FN) over trials (stimulus x fly seed).",
  "bootstrap": {
    "resamples": 4000,
    "seed": 20261107,
    "rule": "Paired percentile bootstrap over stimuli (each resample keeps every fly seed of each drawn stimulus); 95% interval."
  },
  "minimum_meaningful_effect": {
    "f1": 0.1
  },
  "criteria": [
    {
      "id": "V1",
      "primary": true,
      "rule": "Held-out, live runs: F1(eye-lplc2) - F1(deployed) >= 0.10 and the bootstrap interval of the difference excludes 0."
    },
    {
      "id": "V2",
      "rule": "Held-out: the bootstrap interval of F1(eye-lplc2) - F1(geometric-tuned) excludes 0 (above)."
    },
    {
      "id": "V3",
      "rule": "Held-out: eye-lplc2 escapes from at most 25% of translating harmless stimuli (near_miss, lateral, zigzag) with recall >= 0.75."
    },
    {
      "id": "V4",
      "rule": "Held-out: the bootstrap interval of F1(eye-lplc2) - F1(eye-expansion) excludes 0 (above): radial opponency and the all-quadrant combination matter."
    },
    {
      "id": "V5",
      "rule": "Held-out: F1(eye-lplc2) - F1(eye-shuffled) >= 0.20 and its interval excludes 0: retinotopy matters."
    },
    {
      "id": "V6",
      "rule": "Held-out: the median lead of eye-lplc2's hits (collision time minus decision time) >= 50 ms."
    },
    {
      "id": "V7",
      "rule": "Held-out, engineering check: in at least 99% of trials each live run's first escape is the one the held run predicts for its arm (deployed, eye-lplc2 at the chosen gain)."
    }
  ],
  "descriptive": "Reported without criteria: every arm's metrics by stimulus kind, by contrast sign and by illumination; the heuristics; lead distributions; cost.",
