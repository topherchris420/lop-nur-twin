# Server-side configuration for the decision endpoints (/api/jev/decision,
# /api/glide/decision and /api/llm/decision).
#
# Copy to `.env.local` (git-ignored) for local development; `vite` and
# `vite preview` load it for the endpoint only. In production set these in the
# Vercel project: Settings -> Environment Variables.
#
# Never prefix these with VITE_: Vite inlines VITE_* values into the browser
# bundle, where every visitor can read them.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Fastino's Glide for the player's seat (/api/glide/decision): the SystemOne
# protocol Jev speaks, served by Fastino.
#   FASTINO_MODEL  fastino/glide (default), or a fine-tuned model's training-job UUID
# Live evaluations that call it also need FASTINO_LIVE_TEST=1 in the shell that
# runs them; ordinary CI never sets it.
FASTINO_API_KEY=
FASTINO_MODEL=fastino/glide

# A conventional LLM for the player's seat (/api/llm/decision). Provider and
# model are configuration: nothing in the game names a commercial model.
#   LLM_PROVIDER         anthropic | openai-compatible
#   LLM_MODEL            the model id; anthropic defaults to claude-opus-5-5
#   LLM_BASE_URL         openai-compatible only: https://…/v1, or http://localhost…
#   LLM_EFFORT           anthropic only, optional: low | medium | high | xhigh | max
#   LLM_CONFIDENCE       verbalized (default) | none — whether to ask for a stated confidence
#   LLM_TIMEOUT_MS       per decision, 1000–25000 (default 10000)
#   LLM_MAX_RETRIES      transient-failure retries within the deadline, 0–3 (default 1)
#   LLM_MAX_TOKENS       128–16000 (default 1024)
#   LLM_RESPONSE_FORMAT  openai-compatible only: json_schema (default) | json_object | none
# Live evaluations that call it also need LLM_LIVE_TEST=1 in the shell that runs
# the experiment; ordinary CI never sets it.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# The R.A.I.N. Lab inside the Bethesda anomaly (/api/rain/*). Its research
# runtime runs inside this server process (docs/RAIN_LAB_BETHESDA.md); nothing
# below is required. Unset, the lab is LIVE with the offline meeting engine, a
# scratch experiment registry and R.A.I.N.'s bounded choice switched off (it
# answers DISABLED). DEMO needs nothing at all.
#   RAIN_RUNTIME                   local (default) | off — off makes the lab OFFLINE, and say so
#   RAIN_MEETING_ENGINE            offline (default) | model
#   RAIN_LLM_BASE_URL              model only: an OpenAI-compatible server (Ollama, LM Studio,
#                                  llama.cpp); default http://127.0.0.1:11434/v1
#   RAIN_LLM_MODEL                 model only: the model to run, e.g. qwen2.5:7b or qwen2.5-7b-instruct
#   RAIN_LLM_API_KEY               optional bearer token the model server requires
#   RAIN_LM_TIMEOUT                seconds per model call, 30–3600 (default 300)
#   RAIN_MEETING_TURNS             1–30 (default 25)
#   RAIN_MEETING_TIMEOUT_MIN       5–60 (default 45)
#   RAIN_MEETING_RECURSION         true (default) | false — the critique-and-revise pass
#   RAIN_MEETING_PRIVACY           local (default) | hybrid — local refuses a model server that is
#                                  not on this machine or a private network
#   RAIN_MEETING_ARCHIVE_DIR       optional directory that keeps each rain-session-artifact/v1
#   RAIN_DECISION_MODE             off (default) | jev — whether R.A.I.N. may be asked to choose
#                                  among the host's experiment options
#   RAIN_DECISION_REMOTE_ALLOWED   true | false (default): jev mode may send a question to TypeSafe
#   RAIN_DECISION_CALIBRATION      optional path to a rain-decision-calibration/v1 file
#   RAIN_DECISION_MINIMUM_SAMPLES  calibration samples a profile needs (default 100)
#   RAIN_DECISION_TIMEOUT          seconds per decision (default 30)
#   RAIN_REGISTRY_DIR              optional directory for the experiment registry; unset, a
#                                  scratch directory that is discarded with the process. One
#                                  process only: refused on a function deployment (Vercel)
#   RAIN_REGISTRY_SECRET           at least 32 random characters, e.g. `openssl rand -hex 32`.
#                                  Certifies pre-registrations so every function instance can
#                                  check one another made; required for the registry on Vercel,
#                                  optional on one process. Changing it voids the certificates
#                                  of experiments not yet reported.
# Jev as R.A.I.N.'s decision engine uses TYPESAFE_API_KEY and TYPESAFE_MODEL above.
RAIN_LLM_API_KEY=
RAIN_REGISTRY_SECRET=
