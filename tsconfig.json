{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Every file under `src/` is strict-checked, with no exclusions: production
  // source has no parked corners. Unfinished subsystems live in `experiments/`,
  // outside `src/` and outside this project entirely (see `experiments/README.md`).
  //
  // `scripts/` is in the project too. Those files decide what the validator
  // rejects and what the release manifest hashes, so they are production code
  // that happens to run at build time rather than in a browser.
  //
  // `server/` and `api/` hold the one server-side feature, the Jev decision
  // endpoint. They are strict-checked like everything else; the API key they
  // read is server-only by construction (see docs/JEV_BLACKSITE.md).
  "include": ["src", "scripts", "server", "api", "vite.config.ts", "vitest.config.ts"]
}
