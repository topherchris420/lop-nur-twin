# Build output and caches. Nothing here is authored.
dist
dist-ssr
node_modules
coverage
.vite
# Private generated research state and independent scratch checkouts.
.rain-research
.claude/worktrees
.vercel

# Lockfiles are written by their package manager, not by hand. Reformatting one
# is at best noise and at worst makes it unparseable.
bun.lock
package-lock.json

# Generated per build by `scripts/generate-manifest.ts`. Formatting it would
# change bytes the generator is responsible for and break the reproducibility
# claim the file exists to support.
public/model-manifest.json

# Generated by the TanStack router plugin on every dev server and build. It is
# rewritten from `src/routes/`, so any formatting applied here is reverted the
# next time someone runs the app.
src/routeTree.gen.ts

# Binary assets and tool output. Prettier cannot format them and the repository
# rule is that captures are review evidence, not project files.
*.png
*.jpg
*.jpeg
*.ico
*.webp
shots
render_output*.png

# Security scanner output and SBOMs, produced by CI.
sbom*.json
trivy-results.*

# The white paper is a hand-tuned single-file HTML document with a print
# stylesheet; Prettier's HTML formatter rewraps it and moves the layout.
docs/white-paper.html

# Unfinished subsystems, preserved byte-for-byte so the move out of `src/` stays
# a pure rename in the history. See experiments/README.md.
experiments

# Benchmark artifacts are written by `tools/experiment.mjs` and rewritten by
# `--archive` and `--evaluate`. They are records of a run; formatting one by
# hand makes the next re-score a whole-file diff.
docs/benchmarks/**/*.json

# Research-program outputs are immutable evidence, including Markdown/SVG whose
# exact bytes are journaled. The archive's human-written README is still checked.
docs/benchmarks/rain-research-program-validation/programs/
docs/benchmarks/rain-research-program-validation/reports/
docs/benchmarks/rain-research-program-validation/REPORT.md

# The model's recorded revisions: manifests kept byte for byte as each commit's
# own generator wrote them, and the index the recorder writes beside them.
model-history/

# Noeterra's Rust build output, and the civilization experiments the lab archives:
# records are evidence whose exact bytes are hashed, written by
# `npm run rain:civilization`, never by hand.
noeterra/target
docs/benchmarks/noeterra-civilization/

# Digital-fly experiments the lab archives: records are evidence whose exact
# bytes are hashed, written by `npm run rain:fly`, never by hand.
docs/benchmarks/fly-behavior/

# Digital-fly pilots: exploratory sizing runs, never evidence, written by
# `npm run rain:fly -- --pilot` and checked byte for byte by `--pilot --check`.
docs/benchmarks/fly-pilots/

# Why those pilots replay only on their recording platform: the diagnostic
# workflows, scripts and outputs, kept byte for byte as they ran. Only the
# README there is written by hand.
docs/research/echo-replay/run1/
docs/research/echo-replay/run2/
docs/research/echo-replay/windows/

# The organism continuation's rehearsal on the deployed individual's backup,
# and its cutover: the scripts and outputs as they ran, paths aside. Only the
# README there is written by hand.
docs/research/echo-organism-continuation/*.ts
docs/research/echo-organism-continuation/*.js
docs/research/echo-organism-continuation/*.mjs
docs/research/echo-organism-continuation/*.sh
docs/research/echo-organism-continuation/*.json
docs/research/echo-organism-continuation/*.txt

# FlyBody physics on the digital fly's plan: results and the README written from
# them by `python -m fly_physics run` (fly-physics/), each result sealed by its
# own SHA-256.
docs/benchmarks/fly-physics/

# The Noeterra engine copied into public/ at build time (a binary build product).
public/noeterra/

# Noeterra map geography, written by noeterra/scripts/import-geography.mjs with
# the source hashes in geography.source.json. Never reformatted by hand.
noeterra/data/

# The digital fly's imported data: FlyBody's skeleton and meshes, the Virtual
# Fly Brain reference and the grooming ethograms' summaries, written by
# `scripts/import-flybody.ts`, `scripts/import-vfb-reference.ts` and
# `scripts/import-fly-grooming.ts` and hashed by the build validator. Formatting
# one would change bytes its manifest records.
src/bethesda/fly/data/

# The digital fly's calibration against published recordings: written by
# `scripts/fly-calibration.ts` and checked byte for byte by its `--check`.
docs/benchmarks/fly-calibration/

# The connectome backend (fly-neural/): results sealed by their own SHA-256 and
# written by `python -m fly_neural`, the spike fixture written by
# `fly-neural/reference/shiu_brian2.py conformance`, and the pre-registered
# experiment files, whose exact bytes every result records.
docs/benchmarks/fly-neural/
fly-neural/tests/data/
fly-neural/experiments/
