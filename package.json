{
  "name": "desert-airfield-twin",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "a11y": "node tools/a11y.mjs",
    "audio": "node tools/audio.mjs",
    "benchmark:jev": "node tools/jev-benchmark.mjs --brain jev --control direct",
    "benchmark:jev:precision": "node tools/jev-benchmark.mjs --brain jev --control precision",
    "benchmark:glide": "node tools/jev-benchmark.mjs --brain glide --control precision",
    "benchmark:random": "node tools/jev-benchmark.mjs --brain random --control direct",
    "benchmark:random:precision": "node tools/jev-benchmark.mjs --brain random --control precision",
    "build": "node scripts/run-ts.mjs scripts/validate-data.ts && node scripts/run-ts.mjs scripts/validate-bethesda.ts && node scripts/run-ts.mjs scripts/generate-manifest.ts && node scripts/run-ts.mjs scripts/validate-model-history.ts && vite build && tsc --noEmit && node tools/jev-secret-scan.mjs dist",
    "check": "bun run format:check && bun run lint && bun run test:run && bun run test:evidence && bun run build",
    "closeup": "node tools/closeup.mjs",
    "dev": "node scripts/run-ts.mjs scripts/generate-manifest.ts && vite",
    "engagement": "node tools/engagement.mjs",
    "evaluate": "node tools/experiment.mjs --evaluate",
    "experiment": "node tools/experiment.mjs",
    "experiment:shuffle-options": "node tools/experiment.mjs tools/experiments/shuffle-options.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gait": "node tools/gait.mjs",
    "glide": "node tools/glide.mjs",
    "glide:live": "node tools/glide.mjs --live",
    "generate:manifest": "node scripts/run-ts.mjs scripts/generate-manifest.ts",
    "jev": "node tools/jev.mjs",
    "jev:live": "node tools/jev.mjs --live",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "llm": "node tools/llm.mjs",
    "manifest": "node scripts/run-ts.mjs scripts/generate-manifest.ts",
    "model:record": "node scripts/run-ts.mjs scripts/record-model-history.ts",
    "model:verify": "node scripts/run-ts.mjs scripts/record-model-history.ts --verify",
    "preview": "vite preview",
    "replay:jev": "node tools/jev-replay.mjs",
    "routes": "node tools/routes.mjs",
    "scan:secrets": "node tools/jev-secret-scan.mjs dist",
    "shots": "node tools/shots.mjs",
    "smoke": "node tools/smoke.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:eval": "vitest run src/game/eval src/game/pilot server",
    "test:evidence": "node scripts/run-ts.mjs scripts/test-evidence-validation.ts",
    "test:jev": "vitest run src/game/pilot server",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/run-ts.mjs scripts/validate-data.ts",
    "validate:model-history": "node scripts/run-ts.mjs scripts/validate-model-history.ts",
    "test:bethesda": "vitest run src/bethesda src/rain server/jev/city.test.ts server/rain",
    "verify:bethesda": "node tools/bethesda.mjs",
    "verify:rain-lab": "node tools/rain-lab.mjs",
    "rain:conformance": "node tools/rain-conformance.mjs",
    "rain:demo": "node scripts/run-ts.mjs scripts/export-rain-demo.ts",
    "rain:admit": "node tools/rain-admit.mjs",
    "rain:research": "node tools/rain-research.mjs",
    "rain:lineage-demo": "node tools/rain-lineage-demo.mjs",
    "rain:stand-in": "node tools/stand-in-model.mjs",
    "rain:autonomous": "node tools/rain-autonomous.mjs",
    "rain:math:index": "node scripts/run-ts.mjs scripts/math-substrate.ts index",
    "rain:math:verify": "node scripts/run-ts.mjs scripts/math-substrate.ts verify",
    "rain:math:inspect": "node scripts/run-ts.mjs scripts/math-substrate.ts inspect",
    "rain:math:search": "node scripts/run-ts.mjs scripts/math-substrate.ts search",
    "rain:math:portfolio": "node scripts/run-ts.mjs scripts/math-portfolio.ts",
    "rain:discovery": "node tools/rain-discovery.mjs",
    "rain:discovery-demo": "node tools/rain-discovery-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "postprocessing": "^6.39.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "puppeteer": "^25.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "seroval": "^1.6.8",
    "seroval-plugins": "^1.6.8"
  }
}
