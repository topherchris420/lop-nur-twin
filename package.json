{
  "name": "desert-airfield-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/run-ts.mjs scripts/generate-manifest.ts && vite",
    "build": "node scripts/run-ts.mjs scripts/validate-data.ts && node scripts/run-ts.mjs scripts/generate-manifest.ts && vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/run-ts.mjs scripts/validate-data.ts",
    "manifest": "node scripts/run-ts.mjs scripts/generate-manifest.ts",
    "generate:manifest": "node scripts/run-ts.mjs scripts/generate-manifest.ts",
    "test:evidence": "node scripts/run-ts.mjs scripts/test-evidence-validation.ts",
    "smoke": "node tools/smoke.mjs",
    "engagement": "node tools/engagement.mjs",
    "audio": "node tools/audio.mjs",
    "gait": "node tools/gait.mjs",
    "a11y": "node tools/a11y.mjs",
    "routes": "node tools/routes.mjs",
    "closeup": "node tools/closeup.mjs",
    "shots": "node tools/shots.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:run": "vitest run",
    "check": "bun run format:check && bun run lint && bun run test:run && bun run test:evidence && bun run build"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leva": "^0.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "puppeteer": "^25.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
